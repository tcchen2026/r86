# Cargo build outputs (including alternate benchmark target directories).
target/
target-*/
/web/dist/

# Temporary benchmarks, boot artifacts, and downloaded guest media.
tmp/
*.iso
*.iso.part

# Writable guest disk images (bootsector fixtures remain tracked).
*.vhd
*.vhdx
*.vmdk
*.qcow2
*.raw

# Mac app: the Rust library, r86.app and r86.dmg.
/apple/build/

# Python caches and local virtual environments.
__pycache__/
*.py[cod]
/.venv/
/venv/

# Compiler/configure scratch files.
*.o
/config-temp/
/config.log

# Editor/OS scratch files.
*~
*.swp
*.swo
.DS_Store

# Keep Cargo.lock, firmware ROMs, and bootsector fixtures tracked.

# Local-only inputs: reference checkouts and boot media, guest tool sources,
# and private development notes.
/refs/
/assets/*
!/assets/freedos.json
!/assets/freedos-kit.sha256
/private_docs/
/private/

# Don't include md files by default

*.md
!/README.md
!/KNOWN_ISSUES.md

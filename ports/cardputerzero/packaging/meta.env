# Sourced by AppBuilder's scripts/pack-deb.sh (bash). The version is the
# tree's (script/current-tree-version.sh), or R86_VERSION for a tree without
# .git: v2026.11.18-b0dd54 becomes package version 2026.11.18+gitb0dd54.
R86_TREE=${R86_VERSION:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && script/current-tree-version.sh)}
PKG_NAME=r86
PKG_VERSION=$(echo "$R86_TREE" | sed 's/^v\([0-9.]*\)-\(.*\)$/\1+git\2/')
PKG_REVISION=1
PKG_DESC="r86 PC emulator: run FreeDOS, ReactOS and other 32-bit x86 systems"
PKG_MAINTAINER="tcchen2026 <264924385+tcchen2026@users.noreply.github.com>"
PKG_DEPENDS="curl, coreutils"
APP_NAME="r86"
APP_EXEC=/usr/share/APPLaunch/bin/r86
APP_TERMINAL=false
APP_ICON=share/images/r86.png

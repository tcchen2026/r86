diff --git a/pc.c b/pc.c
index bb9472f..d98a83a 100644
--- a/pc.c
+++ b/pc.c
@@ -132,10 +132,61 @@ void pcmalloc_init(void *ptr, long len);
 #define pcmalloc_init(ptr, len)
 #endif
 
+static bool pci_ide_bm_port(PC *pc, int addr, unsigned int *offset)
+{
+	if (!pc->pci_ide_bm_enabled)
+		return false;
+	*offset = (uword)addr - pc->pci_ide_bm_addr;
+	return *offset < 16;
+}
+
+static u8 pci_ide_bm_read8(PC *pc, unsigned int offset)
+{
+	unsigned int channel = offset >> 3;
+
+	switch (offset & 7) {
+	case 0:
+		return pc->pci_ide_bm_command[channel];
+	case 2:
+		return pc->pci_ide_bm_status[channel];
+	case 4: case 5: case 6: case 7:
+		return pc->pci_ide_bm_prdt[channel] >> ((offset & 3) * 8);
+	default:
+		return 0xff;
+	}
+}
+
+static void pci_ide_bm_write8(PC *pc, unsigned int offset, u8 val)
+{
+	unsigned int channel = offset >> 3;
+	unsigned int shift;
+
+	switch (offset & 7) {
+	case 0:
+		/* The attached drives advertise PIO only, so DMA never starts. */
+		pc->pci_ide_bm_command[channel] = val & 0x09;
+		break;
+	case 2:
+		pc->pci_ide_bm_status[channel] =
+			(val & 0x60) |
+			(pc->pci_ide_bm_status[channel] & ~val & 0x06);
+		break;
+	case 4: case 5: case 6: case 7:
+		shift = (offset & 3) * 8;
+		pc->pci_ide_bm_prdt[channel] &= ~(0xffU << shift);
+		pc->pci_ide_bm_prdt[channel] |= (u32)val << shift;
+		break;
+	}
+}
+

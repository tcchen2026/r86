diff --git a/tests/fdc_test.c b/tests/fdc_test.c
new file mode 100644
index 0000000..3f22194
--- /dev/null
+++ b/tests/fdc_test.c
@@ -0,0 +1,68 @@
+#include <assert.h>
+#include <stdint.h>
+
+#include "fdc.h"
+
+struct IrqLog {
+	int rises;
+	int falls;
+	int last_irq;
+};
+
+static void set_irq(void *opaque, int irq, int level)
+{
+	struct IrqLog *log = opaque;
+	log->last_irq = irq;
+	if (level)
+		log->rises++;
+	else
+		log->falls++;
+}
+
+static void command(FDCState *fdc, const uint8_t *bytes, int len)
+{
+	for (int i = 0; i < len; i++)
+		fdc_ioport_write(fdc, 0x3f5, bytes[i]);
+}
+
+int main(void)
+{
+	struct IrqLog irq = {0};
+	FDCState *fdc = fdc_init(6, &irq, set_irq);
+	const uint8_t configure[] = {0x13, 0, 0x30, 0};
+	const uint8_t version[] = {0x10};
+	const uint8_t sense[] = {0x08};
+	const uint8_t read_id[] = {0x0a, 0};
+
+	assert(fdc_ioport_read(fdc, 0x3f4) == 0x80);
+	command(fdc, configure, sizeof(configure));
+	assert(fdc_ioport_read(fdc, 0x3f4) == 0x80);
+	command(fdc, version, sizeof(version));
+	assert(fdc_ioport_read(fdc, 0x3f4) == 0xd0);
+	assert(fdc_ioport_read(fdc, 0x3f5) == 0x90);
+	assert(fdc_ioport_read(fdc, 0x3f4) == 0x80);
+
+	fdc_ioport_write(fdc, 0x3f2, 0);
+	fdc_ioport_write(fdc, 0x3f2, 0x0c);
+	assert(irq.rises == 1);
+	assert(irq.falls >= 1);
+	assert(irq.last_irq == 6);
+	for (int drive = 0; drive < 4; drive++) {
+		command(fdc, sense, sizeof(sense));
+		assert(fdc_ioport_read(fdc, 0x3f4) == 0xd0);
+		assert(fdc_ioport_read(fdc, 0x3f5) == (0xc0 | drive));
+		assert(fdc_ioport_read(fdc, 0x3f5) == 0);
+	}
+	assert(fdc_ioport_read(fdc, 0x3f4) == 0x80);
+
+	command(fdc, read_id, sizeof(read_id));
+	assert(fdc_ioport_read(fdc, 0x3f4) == 0xd0);
+	assert(fdc_ioport_read(fdc, 0x3f5) == 0x48);
+	assert(fdc_ioport_read(fdc, 0x3f5) == 0x04);
+	for (int i = 0; i < 5; i++)
+		(void)fdc_ioport_read(fdc, 0x3f5);
+	assert(fdc_ioport_read(fdc, 0x3f4) == 0x80);
+	assert(irq.rises == 2);
+
+	return 0;
+}
diff --git a/tests/i386_cpuid_test.c b/tests/i386_cpuid_test.c
new file mode 100644
index 0000000..c386b92
--- /dev/null
+++ b/tests/i386_cpuid_test.c
@@ -0,0 +1,45 @@
+#include <assert.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "i386.h"
+
+void *pcmalloc(long size)
+{
+	return calloc(1, size);
+}
+
+int main(void)
+{
+	static const uint8_t code[] = {
+		0xb8, 0x01, 0x00, 0x00, 0x00, /* mov eax, 1 */
+		0x0f, 0xa2,                   /* cpuid */
+		0xa3, 0x00, 0x01, 0x00, 0x00, /* mov [0x100], eax */
+		0x89, 0x1d, 0x04, 0x01, 0x00, 0x00, /* mov [0x104], ebx */
+		0x89, 0x0d, 0x08, 0x01, 0x00, 0x00, /* mov [0x108], ecx */
+		0x89, 0x15, 0x0c, 0x01, 0x00, 0x00, /* mov [0x10c], edx */
+		0xf4, /* hlt */
+	};
+	uint8_t *memory = calloc(1, 1024 * 1024);
+	CPU_CB *cb;
+	CPUI386 *cpu;
+	uint32_t feature_edx;
+
+	assert(memory != NULL);
+	memcpy(memory, code, sizeof(code));
+	cpu = cpui386_new(6, (char *)memory, 1024 * 1024, &cb);
+	assert(cpu != NULL);
+	cpui386_enable_fpu(cpu);
+	cpui386_reset_pm(cpu, 0);
+	cpui386_step(cpu, 16);
+
+	memcpy(&feature_edx, memory + 0x10c, sizeof(feature_edx));
+	assert(feature_edx & (1U << 0)); /* FPU */
+	assert(feature_edx & (1U << 4)); /* TSC */
+	assert(feature_edx & (1U << 8)); /* CMPXCHG8B */
+
+	cpui386_delete(cpu);
+	free(memory);
+	return 0;
+}
diff --git a/tests/ide_atapi_test.c b/tests/ide_atapi_test.c
new file mode 100644
index 0000000..2019a4f
--- /dev/null
+++ b/tests/ide_atapi_test.c
@@ -0,0 +1,254 @@
+#define _POSIX_C_SOURCE 200809L
+
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include "ide.h"
+#include "pci.h"
+
+#define CD_SECTOR_SIZE 2048
+#define TEST_SECTORS 40
+#define READ_SECTORS 34
+
+struct BarLog {
+	uint32_t address;
+	int enabled;
+};
+
+struct IrqLog {
+	int level;
+	int rises;
+};
+
+void *pcmalloc(long size)
+{
+	return calloc(1, size);
+}
+
+static void set_irq(void *opaque, int irq, int level)
+{
+	struct IrqLog *log = opaque;
+
+	(void)irq;
+	if (level && !log->level)
+		log->rises++;
+	log->level = level;
+}
+
+static void set_bar(void *opaque, int bar_num, uint32_t address, bool enabled)
+{
+	struct BarLog *log = opaque;
+
+	assert(bar_num == 4);
+	log->address = address;
+	log->enabled = enabled;
+}
+
+static void pci_select(I440FXState *host, int devfn, int offset)
+{
+	i440fx_write_addr(host, 0, 0x80000000U | (devfn << 8) | offset, 2);
+}
+
+static void test_pci_layout(void)
+{
+	struct BarLog bar = {0};
+	I440FXState *host;
+	PCIBus *bus;
+	PCIDevice *ide;
+	int piix3_devfn;
+	uint32_t value;
+
+	host = i440fx_init(&bus, &piix3_devfn);
+	assert(host != NULL);
+	assert(piix3_devfn == 8);
+
+	pci_select(host, 0, 0);
+	assert(i440fx_read_data(host, 0, 2) == 0x12378086U);
+
+	ide = piix3_ide_init(bus, piix3_devfn + 1);
+	assert(ide != NULL);
+	pci_register_bar(ide, 4, 16, PCI_ADDRESS_SPACE_IO, &bar, set_bar);
+
+	pci_select(host, piix3_devfn + 1, 8);
+	value = i440fx_read_data(host, 0, 2);
+	assert((value & 0xffffff00U) == 0x01018000U);
+
+	pci_select(host, piix3_devfn + 1, 0x20);
+	i440fx_write_data(host, 0, 0xc001, 2);
+	pci_select(host, piix3_devfn + 1, PCI_COMMAND);
+	i440fx_write_data(host, 0, PCI_COMMAND_IO, 1);
+	assert(bar.enabled);
+	assert(bar.address == 0xc000);
+}
+
+static void write_test_image(int fd)
+{
+	uint8_t sector[CD_SECTOR_SIZE];
+	FILE *file = fdopen(fd, "wb");
+
+	assert(file != NULL);
+	for (int sector_no = 0; sector_no < TEST_SECTORS; sector_no++) {
+		for (int i = 0; i < CD_SECTOR_SIZE; i++)
+			sector[i] = (uint8_t)(sector_no * 17 + i * 29);
+		assert(fwrite(sector, 1, sizeof(sector), file) == sizeof(sector));
+	}
+	assert(fclose(file) == 0);
+}
+
+static void test_atapi_long_pio_read(void)
+{
+	char path[] = "/tmp/tiny386-atapi-test-XXXXXX";
+	uint8_t packet[12] = {0x28, 0, 0, 0, 0, 0, 0, 0, READ_SECTORS, 0, 0, 0};
+	uint8_t *output = malloc(READ_SECTORS * CD_SECTOR_SIZE);
+	IDEIFState *ide;
+	struct IrqLog irq = {0};
+	size_t output_pos = 0;
+	uint16_t phases[2];
+	int phase_count = 0;
+	int fd = mkstemp(path);
+
+	assert(fd >= 0);
+	assert(output != NULL);
+	write_test_image(fd);
+
+	ide = ide_allocate(14, &irq, set_irq);
+	assert(ide != NULL);
+	assert(ide_attach_cd(ide, 0, path) == 0);
+	ide_ioport_write(ide, 6, 0xa0);
+	ide_ioport_write(ide, 1, 0);
+	ide_ioport_write(ide, 4, 0xff);
+	ide_ioport_write(ide, 5, 0xff);
+	ide_ioport_write(ide, 7, 0xa0);
+	assert(irq.rises == 0);
+	for (int i = 0; i < 12; i += 2)
+		ide_data_writew(ide, packet[i] | ((uint16_t)packet[i + 1] << 8));
+	assert(irq.rises == 1);
+
+	while (output_pos < READ_SECTORS * CD_SECTOR_SIZE) {
+		uint16_t byte_count;
+		size_t phase_pos = 0;
+
+		assert(ide_ioport_read(ide, 7) & 0x08);
+		byte_count = ide_ioport_read(ide, 4);
+		byte_count |= (uint16_t)ide_ioport_read(ide, 5) << 8;
+		assert(byte_count > 0);
+		assert((byte_count & 1) == 0);
+		assert(phase_count < 2);
+		phases[phase_count++] = byte_count;
+		while (phase_pos < byte_count) {
+			int words = ide_data_read_string(ide,
+				output + output_pos + phase_pos, 2,
+				(byte_count - phase_pos) / 2);
+			assert(words > 0);
+			phase_pos += words * 2;
+		}
+		output_pos += byte_count;
+	}
+
+	assert((ide_ioport_read(ide, 7) & 0x09) == 0);
+	assert(phase_count == 2);
+	assert(phases[0] == 31 * CD_SECTOR_SIZE);
+	assert(phases[1] == 3 * CD_SECTOR_SIZE);
+	for (int sector_no = 0; sector_no < READ_SECTORS; sector_no++) {
+		for (int i = 0; i < CD_SECTOR_SIZE; i++) {
+			uint8_t expected = (uint8_t)(sector_no * 17 + i * 29);
+			assert(output[sector_no * CD_SECTOR_SIZE + i] == expected);
+		}
+	}
+
+	free(output);
+	assert(unlink(path) == 0);
+}

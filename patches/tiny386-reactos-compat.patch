+static void test_atapi_nien_pending_irq(void)
+{
+	char path[] = "/tmp/tiny386-atapi-irq-test-XXXXXX";
+	uint8_t packet[12] = {0x25};
+	IDEIFState *ide;
+	struct IrqLog irq = {0};
+	int fd = mkstemp(path);
+
+	assert(fd >= 0);
+	write_test_image(fd);
+	ide = ide_allocate(14, &irq, set_irq);
+	assert(ide != NULL);
+	assert(ide_attach_cd(ide, 0, path) == 0);
+	ide_ioport_write(ide, 6, 0xa0);
+
+	ide_cmd_write(ide, 0x02);
+	ide_ioport_write(ide, 7, 0xa0);
+	for (int i = 0; i < 12; i += 2)
+		ide_data_writew(ide, packet[i] | ((uint16_t)packet[i + 1] << 8));
+	assert(irq.level == 0);
+	assert(irq.rises == 0);
+
+	ide_cmd_write(ide, 0x00);
+	assert(irq.level == 1);
+	assert(irq.rises == 1);
+	assert(ide_status_read(ide) & 0x08);
+	assert(irq.level == 1);
+	assert(ide_ioport_read(ide, 7) & 0x08);
+	assert(irq.level == 0);
+
+	ide_cmd_write(ide, 0x02);
+	ide_ioport_write(ide, 7, 0xa0);
+	for (int i = 0; i < 12; i += 2)
+		ide_data_writew(ide, packet[i] | ((uint16_t)packet[i + 1] << 8));
+	assert(irq.level == 0);
+	ide_cmd_write(ide, 0x06);
+	ide_cmd_write(ide, 0x00);
+	assert(irq.level == 0);
+	assert(irq.rises == 1);
+
+	assert(unlink(path) == 0);
+}
+
+static void test_atapi_success_clears_error(void)
+{
+	char path[] = "/tmp/tiny386-atapi-error-test-XXXXXX";
+	uint8_t bad_packet[12] = {0xff};
+	uint8_t sense_packet[12] = {0x03, 0, 0, 0, 18};
+	IDEIFState *ide;
+	struct IrqLog irq = {0};
+	int fd = mkstemp(path);
+
+	assert(fd >= 0);
+	write_test_image(fd);
+	ide = ide_allocate(14, &irq, set_irq);
+	assert(ide != NULL);
+	assert(ide_attach_cd(ide, 0, path) == 0);
+	ide_ioport_write(ide, 6, 0xa0);
+
+	ide_ioport_write(ide, 7, 0xa0);
+	for (int i = 0; i < 12; i += 2)
+		ide_data_writew(ide,
+			bad_packet[i] | ((uint16_t)bad_packet[i + 1] << 8));
+	assert(ide_ioport_read(ide, 7) & 0x01);
+	assert(ide_ioport_read(ide, 1) == 0x50);
+
+	ide_ioport_write(ide, 4, 18);
+	ide_ioport_write(ide, 5, 0);
+	ide_ioport_write(ide, 7, 0xa0);
+	for (int i = 0; i < 12; i += 2)
+		ide_data_writew(ide,
+			sense_packet[i] | ((uint16_t)sense_packet[i + 1] << 8));
+	for (int i = 0; i < 9; i++)
+		(void)ide_data_readw(ide);
+	assert((ide_ioport_read(ide, 7) & 0x01) == 0);
+	assert(ide_ioport_read(ide, 1) == 0);
+
+	assert(unlink(path) == 0);
+}
+
+int main(void)
+{
+	test_pci_layout();
+	test_atapi_long_pio_read();
+	test_atapi_nien_pending_irq();
+	test_atapi_success_clears_error();
+	return 0;
+}

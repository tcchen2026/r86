diff --git a/fdc.c b/fdc.c
new file mode 100644
index 0000000..105b2fa
--- /dev/null
+++ b/fdc.c
@@ -0,0 +1,260 @@
+#include "fdc.h"
+
+#include <stdlib.h>
+#include <string.h>
+
+#define FDC_MSR_RQM  0x80
+#define FDC_MSR_DIO  0x40
+#define FDC_MSR_BUSY 0x10
+
+struct FDCState {
+	uint8_t dor;
+	uint8_t dsr;
+	uint8_t ccr;
+	uint8_t command[9];
+	uint8_t command_len;
+	uint8_t command_needed;
+	uint8_t result[16];
+	uint8_t result_pos;
+	uint8_t result_len;
+	uint8_t reset_sense;
+	uint8_t status0;
+	uint8_t cylinder[4];
+	uint8_t config;
+	uint8_t pretrk;
+	int irq;
+	void *pic;
+	void (*set_irq)(void *pic, int irq, int level);
+};
+
+static void fdc_clear_transfer(FDCState *fdc)
+{
+	fdc->command_len = 0;
+	fdc->command_needed = 0;
+	fdc->result_pos = 0;
+	fdc->result_len = 0;
+}
+
+static void fdc_pulse_irq(FDCState *fdc)
+{
+	if (!(fdc->dor & 0x08))
+		return;
+	fdc->set_irq(fdc->pic, fdc->irq, 1);
+	fdc->set_irq(fdc->pic, fdc->irq, 0);
+}
+
+static void fdc_reset(FDCState *fdc)
+{
+	fdc_clear_transfer(fdc);
+	fdc->reset_sense = 4;
+	fdc->status0 = 0xc0;
+	memset(fdc->cylinder, 0, sizeof(fdc->cylinder));
+	fdc_pulse_irq(fdc);
+}
+
+static void fdc_set_result(FDCState *fdc, const uint8_t *bytes, int len)
+{
+	memcpy(fdc->result, bytes, len);
+	fdc->result_pos = 0;
+	fdc->result_len = len;
+	fdc->command_len = 0;
+	fdc->command_needed = 0;
+}
+
+static int fdc_command_size(uint8_t command)
+{
+	switch (command & 0x1f) {
+	case 0x03: return 3; /* specify */
+	case 0x04: return 2; /* sense drive status */
+	case 0x05: case 0x06: case 0x09: case 0x0c:
+	case 0x11: case 0x19: case 0x1d:
+		return 9;
+	case 0x07: return 2; /* recalibrate */
+	case 0x08: return 1; /* sense interrupt status */
+	case 0x0a: return 2; /* read ID */
+	case 0x0d: return 6; /* format track */
+	case 0x0e: return 1; /* dump registers */
+	case 0x0f: return 3; /* seek */
+	case 0x10: return 1; /* version */
+	case 0x12: return 2; /* perpendicular mode */
+	case 0x13: return 4; /* configure */
+	case 0x14: return 1; /* unlock */
+	default: return 1;
+	}
+}
+
+static void fdc_absent_media_result(FDCState *fdc)
+{
+	uint8_t drive = fdc->command[1] & 3;
+	uint8_t result[7] = {
+		(uint8_t)(0x48 | drive), 0x04, 0,
+		fdc->command[2], fdc->command[3], fdc->command[4],
+		fdc->command[5]
+	};
+
+	fdc_set_result(fdc, result, sizeof(result));
+	fdc_pulse_irq(fdc);
+}
+
+static void fdc_execute_command(FDCState *fdc)
+{
+	uint8_t command = fdc->command[0];
+	uint8_t base = command & 0x1f;
+	uint8_t result[10];
+	uint8_t drive;
+	switch (base) {
+	case 0x03: /* specify */
+	case 0x12: /* perpendicular mode */
+		fdc_clear_transfer(fdc);
+		break;
+	case 0x04: /* sense drive status */
+		result[0] = (fdc->command[1] & 7) | 0x10;
+		fdc_set_result(fdc, result, 1);
+		break;
+	case 0x05: case 0x06: case 0x09: case 0x0a:
+	case 0x0c: case 0x0d: case 0x11: case 0x19: case 0x1d:
+		fdc_absent_media_result(fdc);
+		break;
+	case 0x07: /* recalibrate */
+		drive = fdc->command[1] & 3;
+		fdc->cylinder[drive] = 0;
+		fdc->status0 = 0x70 | drive;
+		fdc_clear_transfer(fdc);
+		fdc_pulse_irq(fdc);
+		break;
+	case 0x08: /* sense interrupt status */
+		if (fdc->reset_sense) {
+			drive = 4 - fdc->reset_sense--;
+			result[0] = 0xc0 | drive;
+			result[1] = fdc->cylinder[drive];
+			fdc_set_result(fdc, result, 2);
+		} else if ((fdc->status0 & 0x80) == 0) {
+			drive = fdc->status0 & 3;
+			result[0] = fdc->status0;
+			result[1] = fdc->cylinder[drive];
+			fdc->status0 = 0x80;
+			fdc_set_result(fdc, result, 2);
+		} else {
+			result[0] = 0x80;
+			fdc_set_result(fdc, result, 1);
+		}
+		break;
+	case 0x0e: /* dump registers */
+		memcpy(result, fdc->cylinder, 4);
+		result[4] = 0xdf;
+		result[5] = 0x02;
+		result[6] = 0;
+		result[7] = 0;
+		result[8] = fdc->config;
+		result[9] = fdc->pretrk;
+		fdc_set_result(fdc, result, 10);
+		break;
+	case 0x0f: /* seek */
+		drive = fdc->command[1] & 3;
+		fdc->cylinder[drive] = fdc->command[2];
+		fdc->status0 = 0x70 | drive;
+		fdc_clear_transfer(fdc);
+		fdc_pulse_irq(fdc);
+		break;
+	case 0x10: /* version */
+		result[0] = 0x90;
+		fdc_set_result(fdc, result, 1);
+		break;
+	case 0x13: /* configure */
+		fdc->config = fdc->command[2];
+		fdc->pretrk = fdc->command[3];
+		fdc_clear_transfer(fdc);
+		break;
+	case 0x14: /* unlock */
+		result[0] = 0;
+		fdc_set_result(fdc, result, 1);
+		break;
+	default:
+		result[0] = 0x80;
+		fdc_set_result(fdc, result, 1);
+		break;
+	}
+}
+
+FDCState *fdc_init(int irq, void *pic,
+		   void (*set_irq)(void *pic, int irq, int level))
+{
+	FDCState *fdc = calloc(1, sizeof(*fdc));
+
+	fdc->dor = 0x0c;
+	fdc->status0 = 0x80;
+	fdc->irq = irq;
+	fdc->pic = pic;
+	fdc->set_irq = set_irq;
+	return fdc;
+}
+
+uint8_t fdc_ioport_read(FDCState *fdc, uint16_t addr)
+{
+	switch (addr & 7) {
+	case 0: return 0;
+	case 1: return 0;
+	case 2: return fdc->dor;
+	case 3: return 0x20;
+	case 4:
+		if (fdc->result_pos < fdc->result_len)
+			return FDC_MSR_RQM | FDC_MSR_DIO | FDC_MSR_BUSY;
+		if (fdc->command_len)
+			return FDC_MSR_RQM | FDC_MSR_BUSY;
+		return FDC_MSR_RQM;
+	case 5:
+		if (fdc->result_pos < fdc->result_len) {
+			uint8_t value = fdc->result[fdc->result_pos++];
+			if (fdc->result_pos == fdc->result_len) {
+				fdc->result_pos = 0;
+				fdc->result_len = 0;
+			}
+			return value;
+		}
+		return 0xff;
+	case 7: return 0x80; /* no media */
+	default: return 0xff;
+	}
+}
+
+void fdc_ioport_write(FDCState *fdc, uint16_t addr, uint8_t val)
+{
+	switch (addr & 7) {
+	case 2: {
+		int was_enabled = fdc->dor & 0x04;
+		fdc->dor = val;
+		if (!(val & 0x04)) {
+			fdc_clear_transfer(fdc);
+			fdc->reset_sense = 0;
+			fdc->status0 = 0x80;
+			fdc->set_irq(fdc->pic, fdc->irq, 0);
+		} else if (!was_enabled) {
+			fdc_reset(fdc);
+		}
+		break;
+	}
+	case 3:
+		break;
+	case 4:
+		fdc->dsr = val & 0x7f;
+		if (val & 0x80)
+			fdc_reset(fdc);
+		break;
+	case 5:
+		if (fdc->result_pos < fdc->result_len)
+			break;
+		if (!fdc->command_len) {
+			fdc->command[0] = val;
+			fdc->command_len = 1;
+			fdc->command_needed = fdc_command_size(val);
+		} else if (fdc->command_len < sizeof(fdc->command)) {
+			fdc->command[fdc->command_len++] = val;
+		}
+		if (fdc->command_len >= fdc->command_needed)
+			fdc_execute_command(fdc);
+		break;
+	case 7:
+		fdc->ccr = val & 3;
+		break;
+	}
+}

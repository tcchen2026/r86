// r86-win.exe's resources: icon, manifest, the library, New VM and Edit VM
// dialogs and version (build.rs compiles them with windres; R86_FILEVERSION and
// R86_VERSION come from there). Control IDs match main.rs, wizard.rs and
// edit_vm.rs.
#include <windows.h>

1 ICON "r86.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "r86-win.manifest"

// The library: the app's main window
100 DIALOGEX 0, 0, 330, 190
STYLE DS_CENTER | WS_OVERLAPPED | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "r86"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    LTEXT "Virtual machines", -1, 7, 7, 196, 9
    LISTBOX 10, 7, 18, 196, 165, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "&New...", 11, 210, 18, 113, 15
    DEFPUSHBUTTON "&Start", IDOK, 210, 36, 113, 15
    PUSHBUTTON "&Edit this VM...", 15, 210, 54, 113, 15
    PUSHBUTTON "&Delete...", 12, 210, 72, 113, 15
    PUSHBUTTON "Show &files", 13, 210, 90, 113, 15
    LTEXT "", 14, 210, 114, 113, 69
END

// New virtual machine: one step at a time, as the handheld's wizard. The
// list (drawn by wizard.rs: choice, then its detail on the right) serves the
// choice steps; the name and summary the last one.
101 DIALOGEX 0, 0, 280, 196
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "New virtual machine"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    LTEXT "", 30, 7, 7, 220, 10
    RTEXT "", 31, 230, 7, 43, 10
    LISTBOX 32, 7, 20, 266, 124, LBS_NOTIFY | LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    LTEXT "&Name", 33, 7, 23, 40, 9
    EDITTEXT 20, 50, 21, 223, 13, ES_AUTOHSCROLL
    LTEXT "", 34, 50, 42, 223, 100
    LTEXT "", 35, 7, 148, 266, 20
    PUSHBUTTON "< &Back", 36, 99, 175, 50, 15
    DEFPUSHBUTTON "&Next >", IDOK, 153, 175, 66, 15
    PUSHBUTTON "Cancel", IDCANCEL, 223, 175, 50, 15
END

// Edit this VM: the handheld's settings that the Windows app uses
102 DIALOGEX 0, 0, 260, 138
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Edit VM"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    LTEXT "&OS type", -1, 7, 9, 60, 9
    COMBOBOX 40, 70, 7, 183, 160, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "&Memory", -1, 7, 27, 60, 9
    COMBOBOX 41, 70, 25, 100, 160, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "&CD", -1, 7, 45, 60, 9
    EDITTEXT 42, 70, 43, 81, 13, ES_AUTOHSCROLL | ES_READONLY
    PUSHBUTTON "&Choose...", 43, 155, 42, 50, 15
    PUSHBUTTON "E&ject", 44, 209, 42, 44, 15
    LTEXT "&Boot", -1, 7, 63, 60, 9
    COMBOBOX 45, 70, 61, 100, 60, CBS_DROPDOWNLIST | WS_TABSTOP
    AUTOCHECKBOX "&Network", 46, 70, 79, 183, 10
    LTEXT "", 47, 7, 95, 246, 18
    DEFPUSHBUTTON "OK", IDOK, 147, 117, 50, 15
    PUSHBUTTON "Cancel", IDCANCEL, 203, 117, 50, 15
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION R86_FILEVERSION
PRODUCTVERSION R86_FILEVERSION
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "r86"
            VALUE "FileVersion", R86_VERSION
            VALUE "OriginalFilename", "r86-win.exe"
            VALUE "ProductName", "r86"
            VALUE "ProductVersion", R86_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
